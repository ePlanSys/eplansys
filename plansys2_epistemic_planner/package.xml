<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>plansys2_epistemic_planner</name>
  <version>0.1.0</version>
  <description>Epistemic plan solver plugin for PlanSys2 based on multi-agent Kripke models.</description>
  <maintainer email="thesis@eplansys.dev">Thesis Dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>plansys2_core</depend>
  <depend>plansys2_msgs</depend>
  <depend>pluginlib</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <plansys2_core plugin="${prefix}/plansys2_epistemic_planner_plugin.xml"/>
  </export>
</package>