repositories:
  cascade_lifecycle:
    type: git
    url: https://github.com/fmrico/cascade_lifecycle.git
    version: rolling-devel
  popf:
    type: git
    url: https://github.com/fmrico/popf.git
    version: rolling-devel
  # The EPDDL grounder plansys2_epddl_grounder runs. It is a plain CMake
  # project rather than a ROS package, so colcon builds it as one and installs
  # the binary into <prefix>/bin, which puts `plank` on PATH once the workspace
  # is sourced. Without it the epistemic packages still build; only the EPDDL
  # front end is unavailable, and it says so.
  # The epistemic planner. plansys2_epistemic_planner links its planning core
  # as a library, and its epistemic_planner binary is what
  # plansys2_aletheia_plan_solver runs; colcon installs it into <prefix>/bin.
  # Pinned to a commit, because the plugins validate and serialise plans with
  # this library and a moving branch would change what they accept.
  aletheia:
    type: git
    url: https://github.com/HanielUlises/Aletheia.git
    version: 32036843b1277f68f62b61aaa6fa58233894a779
  plank:
    type: git
    url: https://github.com/HanielUlises/plank.git
    version: main
#   behavior_tree_cpp:
#     type: git
#     url: https://github.com/BehaviorTree/BehaviorTree.CPP.git
#     version: 4.7.0

