# Initialise the epistemic state from a grounded task.
#
# The state node holds one task at a time: its Kripke model, the event models
# of its actions, and the vocabulary both are expressed in. Loading a task
# resets the model to that task's initial state.

# The grounded task in the IePC JSON format, inline. Empty to load from a path
# instead.
string task_json

# Path to the same thing on disk. Ignored when task_json is set.
string task_file

# EPDDL sources to ground into the task, for callers that have the sources
# rather than a grounded file. Both paths are required to use this route, and
# it is taken only when neither task_json nor task_file is set. Libraries may
# be left empty, which uses the packaged `intermediate` action-type library.
string epddl_domain
string epddl_problem
string[] epddl_libraries
---
bool success
string error

# What was loaded, for the caller to check it got the task it meant.
uint32 num_worlds
uint32 num_agents
uint32 num_actions
