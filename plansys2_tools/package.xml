<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>plansys2_tools</name>
  <version>3.0.0</version>

  <description>A set of tools for monitoring ROS2 Planning System</description>

  <maintainer email="fmrico@gmail.com">Francisco Martin Rico</maintainer>

  <license>Apache License, Version 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- rqt is Qt5 up to Iron and Qt6 from Jazzy onward, and a plugin must be
       built against the same major version as qt_gui_cpp. Both dev packages
       are named here, conditionally, so that whichever one CMake picks is
       actually installed. -->
  <build_depend condition="$ROS_DISTRO == 'foxy' or $ROS_DISTRO == 'galactic' or $ROS_DISTRO == 'humble' or $ROS_DISTRO == 'iron'">qtbase5-dev</build_depend>
  <build_depend condition="$ROS_DISTRO == 'jazzy' or $ROS_DISTRO == 'kilted' or $ROS_DISTRO == 'rolling'">qt6-base-dev</build_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>plansys2_msgs</depend>
  <depend>rqt_gui</depend>
  <depend>rqt_gui_cpp</depend>
  <depend>qt_gui_cpp</depend>
  <depend>plansys2_problem_expert</depend>

  <exec_depend>libqt5-widgets</exec_depend>

  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_index_cpp</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rqt_gui plugin="${prefix}/plugin_knowledge.xml"/>
    <rqt_gui plugin="${prefix}/plugin_performers.xml"/>
    <rqt_gui plugin="${prefix}/plugin_plan.xml"/>
  </export>
</package>
