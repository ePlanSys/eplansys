<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eplansys_demo</name>
  <version>0.0.1</version>
  <description>
    The corridor mission: two robots, a corridor nobody has looked down, and a
    goal that no classical planner can state. Runs in one command, with no
    simulator and no hardware, so that what is on show is the planning and not
    the plumbing.
  </description>
  <maintainer email="hanielulises2003@gmail.com">Haniel Ulises</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>plansys2_msgs</depend>
  <depend>plansys2_executor</depend>
  <depend>plansys2_planner</depend>
  <depend>plansys2_problem_expert</depend>
  <depend>plansys2_domain_expert</depend>
  <depend>plansys2_pddl_parser</depend>

  <exec_depend>plansys2_bringup</exec_depend>
  <exec_depend>plansys2_epistemic_executor</exec_depend>
  <exec_depend>plansys2_epistemic_planner</exec_depend>
  <exec_depend>plansys2_epistemic_bt_builder</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
