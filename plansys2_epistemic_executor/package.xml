<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>plansys2_epistemic_executor</name>
  <version>0.1.0</version>
  <description>
    Execution of epistemic policies: a behavior tree architecture extending
    PlanSys2's with knowledge guards, DEL updates and branching on what was
    observed, together with the epistemic state those nodes consult.
  </description>
  <maintainer email="thesis@eplansys.dev">Thesis Dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_msgs</depend>
  <depend>behaviortree_cpp</depend>
  <depend>plansys2_msgs</depend>
  <depend>plansys2_epistemic_msgs</depend>
  <depend>plansys2_epddl_grounder</depend>
  <depend>plansys2_epistemic_planner</depend>
  <depend>nlohmann-json-dev</depend>

  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
